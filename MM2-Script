local function askToEnable()
    local gui = Instance.new("ScreenGui")
    gui.Name = "MM2_RevealGui"
    gui.ResetOnSpawn = false
    gui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 120)
    frame.Position = UDim2.new(0.5, -150, 0.5, -60)
    frame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
    frame.BorderSizePixel = 2
    frame.BorderColor3 = Color3.fromRGB(150, 0, 255)
    frame.Parent = gui

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 0, 60)
    text.BackgroundTransparency = 1
    text.Text = "هل تريد تفعيل كشف اللاعبين والقتلة؟"
    text.TextColor3 = Color3.new(1, 1, 1)
    text.Font = Enum.Font.SourceSansBold
    text.TextSize = 16
    text.TextWrapped = true
    text.Parent = frame

    local btnYes = Instance.new("TextButton")
    btnYes.Size = UDim2.new(0.4, 0, 0, 30)
    btnYes.Position = UDim2.new(0.05, 0, 0, 70)
    btnYes.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    btnYes.Text = "نعم"
    btnYes.TextColor3 = Color3.new(1, 1, 1)
    btnYes.Font = Enum.Font.SourceSansBold
    btnYes.Parent = frame

    local btnNo = Instance.new("TextButton")
    btnNo.Size = UDim2.new(0.4, 0, 0, 30)
    btnNo.Position = UDim2.new(0.55, 0, 0, 70)
    btnNo.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    btnNo.Text = "لا"
    btnNo.TextColor3 = Color3.new(1, 1, 1)
    btnNo.Font = Enum.Font.SourceSansBold
    btnNo.Parent = frame

    local enabled = false

    btnYes.MouseButton1Click:Connect(function()
        enabled = true
        gui:Destroy()
    end)

    btnNo.MouseButton1Click:Connect(function()
        enabled = false
        gui:Destroy()
    end)

    return function() return enabled end
end

local isEnabled = askToEnable()


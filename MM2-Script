-- ============ كشف الدور ============
-- نفحص Character + Backpack سوا، ونفحص إذا الأداة Tool حقيقي مو ملحق
local function getRoleColor(char, plr)
    -- قاتل؟
    local knifeChar = char:FindFirstChild("Knife")
    if knifeChar and knifeChar:IsA("Tool") then
        return Color3.fromRGB(255, 0, 0)
    end

    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        local knifeBp = backpack:FindFirstChild("Knife")
        if knifeBp and knifeBp:IsA("Tool") then
            return Color3.fromRGB(255, 0, 0)
        end
    end

    -- شريف؟
    local gunChar = char:FindFirstChild("Gun")
    if gunChar and gunChar:IsA("Tool") then
        return Color3.fromRGB(0, 100, 255)
    end

    if backpack then
        local gunBp = backpack:FindFirstChild("Gun")
        if gunBp and gunBp:IsA("Tool") then
            return Color3.fromRGB(0, 100, 255)
        end
    end

    -- عادي
    return Color3.fromRGB(0, 255, 0)
end

local function updateHighlights()
    if not isEnabled() then return end

    for _, other in ipairs(game.Players:GetPlayers()) do
        if other ~= player and other.Character then
            local char = other.Character
            local color = getRoleColor(char, other)

            local hl = char:FindFirstChild("RevealHighlight")
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "RevealHighlight"
                hl.Parent = char
            end
            hl.FillColor = color
            hl.OutlineColor = color
        end
    end

    -- تنظيف الهايلايت
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Highlight") and obj.Name == "RevealHighlight" then
            local model = obj.Parent
            if model and model:FindFirstChildOfClass("Humanoid") then
                local p = game.Players:GetPlayerFromCharacter(model)
                if p == player or not p then
                    obj:Destroy()
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        updateHighlights()
        task.wait(0.5)
    end
end)
